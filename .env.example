# ── Servidor ────────────────────────────────────────────────────────────────
PORT=5173
WS_PORT=8765

# 127.0.0.1 = solo este ordenador (recomendado).
# 0.0.0.0 = accesible desde la red o por Tailscale; en ese caso AUTH_TOKEN es
# OBLIGATORIO y el servidor se niega a arrancar sin él.
HOST=127.0.0.1

# Token de acceso para cuando HOST no sea loopback. Genera uno con:
#   node -e "console.log(crypto.randomUUID())"
# Luego entra una vez con  http://tu-host:5173/dashboard/index.html?token=EL_TOKEN
# y queda guardado en una cookie.
AUTH_TOKEN=

# ── Datos ───────────────────────────────────────────────────────────────────
# Por defecto la base de datos vive fuera del repo, en
#   ~/.local/share/90minutos/90minutos.db
# Descomenta para llevarla a otro sitio (otro disco, una carpeta de backups…).
# DATA_DIR=/ruta/a/mis/datos
# DB_PATH=/ruta/a/mis/datos/90minutos.db

# NO pongas el .db en Dropbox, Drive, Nextcloud ni Syncthing: sincronizan el
# archivo entero sin entender cómo escribe SQLite y lo corrompen.
