# Server
PORT=5173
HOST=127.0.0.1
BASE_URL=http://127.0.0.1:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sheets / Calendar
SHEET_ID=your-google-sheet-id
# Optional: alternate Sheet env key used in legacy scripts
GOOGLE_SHEETS_ID=
# Optional: override for events created in Google Calendar
GOOGLE_CALENDAR_ID=primary

# Govee
GOVEE_API_KEY=your-govee-api-key
GOVEE_DEVICE_ESTUDIO=AA:BB:CC:DD:EE:FF:00:11
GOVEE_MODEL_ESTUDIO=H6047
GOVEE_DEVICE_SALON=AA:BB:CC:DD:EE:FF:00:22
GOVEE_MODEL_SALON=H6046

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_USER_ID=your-telegram-user-id

# Tokens are generated at runtime and must stay out of git
# server/data/tokens.json
